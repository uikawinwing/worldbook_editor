{
  "extends": "../../Toolchain/tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "skipLibCheck": true,
    "paths": {
      "@util/*": ["../../Toolchain/util/*"],
      "@/*": ["./src/*"],
      "*": ["../../Toolchain/node_modules/*"]
    },
    "typeRoots": [
      "../../Toolchain/node_modules/@types",
      "../../Toolchain/node_modules"
    ]
  },
  "include": [
    "src",
    "../../Toolchain/@types",
    "../../Toolchain/global.d.ts",
    "../../Toolchain/auto-imports.d.ts",
    "../../Toolchain/auto-imports.zod.d.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
